)
#this incorporates the TF-IDF calculation to push down the scores of common words while boosting
#the score for the rarer words
manifest <- read.csv("../data/C19_novels_manifest.csv", row.names = 1)
#I'm reinitializing manifest to double check there's no errors
dtm_tfidf$dimnames$Docs <- manifest$title
#### this bottom section for the new graph works the same as above but with TD-IDF weighted added
tfidf_counts <- as.matrix(dtm_tfidf)
tfidf_counts <- data.frame(sort(colSums(tfidf_counts), decreasing = TRUE))
tfidf_counts <- cbind(newColName = rownames(tfidf_counts), tfidf_counts)
colnames(tfidf_counts) <- c("term", "tfidf")
tfidf_counts #checking to see that it works
ggplot(data = tfidf_counts[1:50, ]) +
aes(x = fct_reorder(term, -tfidf), y = tfidf) +
geom_bar(stat = "identity") +
theme(
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1)
) +
labs(
title = "Words with the 50-highest TF-IDF scores in 18 Nineteenth-Century Novels",
x = "Word",
y = "TF-IDF"
)
#We got a lot of names because the names are unique to each text
findAssocs(dtm_tfidf, terms = "boat", corlimit = .85)
findAssocs(dtm_tfidf, terms = "writing", corlimit = .85)
#the correlations match the expected ones from the course reader
#the correlated words are more specific to the context rather than just being common terms now
#this next section focuses on the uniqueness of the novels now
tfidf_df <- as.matrix(dtm_tfidf)
tfidf_df <- as.data.frame(t(tfidf_df))
colnames(tfidf_df) <- manifest$title
#the 't' in the second line is for transpose; it flips the rows and columns of the matrix
#this will help us focus on how each novel relates to the terms it uses
ordering <- order(tfidf_df$Dracula, decreasing = TRUE)
rownames(tfidf_df[ordering[1:50], ])
#the first line organizes our rows by the highest value for a given column; helps us find the unique terms
#in every novel
#this example is for Dracula
#there are no contractions
ordering <- order(tfidf_df$Frankenstein, decreasing = TRUE)
rownames(tfidf_df[ordering[1:50], ])
ordering <- order(tfidf_df$SenseandSensibility, decreasing = TRUE)
rownames(tfidf_df[ordering[1:50], ])
# no contractions for these two either
findAssocs(dtm, "boat", .85) #This provides us with words that are used in connection with the word
writing <- findAssocs(dtm, "writing", .85)
writing[[1]][1:15] #same goal as above, but this only provides us with the first 15 with the strongest correlation
inspect(dtm) #this gives us a high level view of the corpus
findFreqTerms(dtm, 1000) #provides us with the terms that appear more than 1000 times in the corpus
