library("tidyverse")
library("tm")
library("tokenizers")
library("ggplot2")
dtm <- readRDS("../data/dtm.rds")
dtm$ncol #this is to get the number of columns in the dtm, which basically gives us information on the word size
#there are 34925 words
dtm$nrow #number of rows, aka the number of documents/texts that make up the matrix
#there are 18 texts
dtm$dimnames$Docs
#the document names are just labeled by numbers instead of by the text title, so to fix that we need to
#use our manifest to provide the corresponding title to every row
manifest <- read.csv("../data/C19_novels_manifest.csv", row.names = 1)
manifest
dtm$dimnames$Docs <- manifest$title #here we assign the right names to the texts
dtm$dimnames$Docs #check to see that it works
inspect(dtm) #this gives us a high level view of the corpus
#shows us an overview of the corpus; has some of the texts alongside some of the words and their frequency
findFreqTerms(dtm, 1000) #provides us with the terms that appear more than 1000 times in the corpus
findAssocs(dtm, "boat", .85) #This provides us with words that are used in connection with the word
#'boat' and have at least a .85 correlation to it
writing <- findAssocs(dtm, "writing", .85)
writing[[1]][1:15] #same goal as above, but this only provides us with the first 15 with the strongest correlation
term_counts <- as.matrix(dtm) #transforms the dtm into a matrix
#each row represents a document, and each column represents a unique word
#The cells in the matrix store word counts for each word-document pair
term_counts <- data.frame(sort(colSums(term_counts), decreasing = TRUE))
#colSums(term_counts) finds the sum of counts for each word across all documents (in the corpus), which
#gives you the overall frequency of every word in the corpus
#sort(..., decreasing = TRUE) organizes the words in descending order of their total counts,
#so the most frequently occurring words appear first
term_counts <- cbind(newColName = rownames(term_counts), term_counts)
colnames(term_counts) <- c("term", "count")
#using the cbind function adds a column of the term names (aka the words themselves)
#and the column names are relabeled to make it clearer what they represent (the word and its respective count)
term_counts #to check that it worked as expected
ggplot(term_counts[1:50, ]) +
aes(x = fct_reorder(term, -count), y = count) +
geom_bar(stat = "identity") +
theme(
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1)
) +
labs(
title = "Top 50 words in 18 Nineteenth-Century Novels",
x = "Word",
y = "Count"
)
#this bar graph will show the top 50 words (so the top 50 from term_counts)
#The issue is that most of these words aren't special to our 19th century collection, they're just very
#common English words in general, so we need to be more specific to find out what makes our corpus special
cleaned_corpus <- readRDS("../data/C19_novels_cleaned.rds")
#Im using this data because that's the data used in the course reader
cleaned_corpus <- VCorpus(VectorSource(cleaned_corpus))
#convert to VCorpus; I had problems later on in my script and I think it was because this corpus was
#not in the right format, so it wasn't properly working with the DocumentTermMatrix function from the
#tm library. I asked Microsoft Copilot how to put it in the right format for it to work with this function
#and it gave me this line. This type of corpus will allow the TF-IDF calculation to be computed on it
cleaned_corpus <- tm_map(
cleaned_corpus,
content_transformer(function(x) str_remove_all(x, "\\'s"))
)
#Im cleaning the corpus from contractions as suggested by the course reader before I proceed with the
#creation of the matrix
#This is the course reader's tm_map() function that didn't work
#cleaned_corpus <- tm_map(
#  cleaned_corpus, str_remove_all, pattern = "\\'s", replacement = " "
#)
#What I did was just utilize the str_remove_all function the right way by plugging in what I wanted ro remove
#I asked Microsoft Copilot for help on how to apply the function to a corpus though and it told me that I
#should utilize "content_transformer"; this function wraps regular string-processing functions (like str_replace_all)
#so they focus only on the text content of each document while ignoring metadata.
dtm_tfidf <- DocumentTermMatrix(
cleaned_corpus,
control = list(weighting = weightTfIdf)
)
#this incorporates the TF-IDF calculation to push down the scores of common words while boosting
#the score for the rarer words
manifest <- read.csv("../data/C19_novels_manifest.csv", row.names = 1)
#I'm reinitializing manifest to double check there's no errors
dtm_tfidf$dimnames$Docs <- manifest$title
